<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.DhakaRoadNet" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/dhaka_background</item>
        <item name="android:navigationBarColor">@color/dhaka_surface</item>
        <item name="colorPrimary">@color/dhaka_primary</item>
        <item name="colorPrimaryDark">@color/dhaka_primary_dark</item>
        <item name="colorSecondary">@color/dhaka_accent</item>
        <item name="colorSurface">@color/dhaka_surface</item>
        <item name="colorOnSurface">@color/dhaka_text_primary</item>
        <item name="materialButtonStyle">@style/Widget.DhakaRoadNet.Button</item>
    </style>

    <style name="Theme.DhakaRoadNet" parent="Base.Theme.DhakaRoadNet" />

    <style name="Widget.DhakaRoadNet.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans</item>
    </style>
</resources>
